# Caddy listens on 8080 inside the compose network.
# Cloudflare Tunnel terminates TLS publicly and points at http://localhost:8090
# (mapped to container :8080). TLS happens at Cloudflare's edge.
#
# Phase 3 introduces path-based routing:
#   /healthz, /readyz, /auth/*, /me, /broker, /broker/* → FastAPI backend
#   /api/health                                         → backend stays;
#   everything else                                     → Next.js frontend

{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# CSP for the SPA (Phase 3): allow same-origin scripts/styles/connects
		# plus Google Fonts (used by the Inter / JetBrains Mono webfonts) and
		# inline scripts that Next.js injects for hydration.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}
}

(backend_proxy) {
	reverse_proxy backend:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

(frontend_proxy) {
	reverse_proxy frontend:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

:8080 {
	encode gzip zstd
	import common_headers

	# ---- Backend routes (paths owned by FastAPI) ----
	handle /healthz {
		import backend_proxy
	}
	handle /readyz {
		import backend_proxy
	}
	handle /auth/* {
		import backend_proxy
	}
	handle /me {
		import backend_proxy
	}
	handle /me/* {
		import backend_proxy
	}
	handle /broker {
		import backend_proxy
	}
	handle /broker/* {
		import backend_proxy
	}
	handle /aurum {
		import backend_proxy
	}
	handle /aurum/* {
		import backend_proxy
	}

	# ---- Everything else → Next.js frontend ----
	handle {
		import frontend_proxy
	}

	log {
		output stdout
		format json
		level INFO
	}
}
