# =============================================================
# aurum-platform — environment template
# Copy to .env and fill in. NEVER commit .env.
# Generate cryptographic values with: python scripts/generate_keys.py
# =============================================================

# ---- Owner / bootstrap ----
OWNER_EMAIL=flevian@example.com
OWNER_DISPLAY_NAME=Flevian Gonsalves

# ---- Public origin / WebAuthn relying party ----
PUBLIC_ORIGIN=https://anvisutra.com
RP_ID=anvisutra.com
RP_NAME=Aurum Platform

# ---- Postgres ----
POSTGRES_USER=aurum
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aurum
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aurum:change-me-strong-password@postgres:5432/aurum

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- JWT (HS256) ----
# 64+ random bytes, base64-encoded. Run: python scripts/generate_keys.py
JWT_SECRET=replace-with-output-of-generate_keys.py
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---- Master encryption key for credential at-rest (libsodium SecretBox) ----
# 32 random bytes, base64-encoded. Run: python scripts/generate_keys.py
MASTER_KEY=replace-with-output-of-generate_keys.py

# ---- Environment / logging ----
APP_ENV=production
LOG_LEVEL=INFO

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://anvisutra.com

# ---- Test mode (only set for pytest containers) ----
# TEST_DATABASE_URL=postgresql+asyncpg://aurum:change-me-strong-password@postgres:5432/aurum_test
